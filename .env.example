# ---------------------------------------------------------------------------
# Interlock configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# --- Database ---------------------------------------------------------------
# PostgreSQL 16 running as a local Windows service.
DATABASE_URL=postgresql+psycopg://interlock_app:CHANGEME@127.0.0.1:5432/interlock

# --- Timezone ---------------------------------------------------------------
# Every datetime in the system is timezone-aware. Storage is UTC; this is the
# timezone used to resolve "today", due dates, and the 09:00 / 17:00 triggers.
TIMEZONE=Asia/Kolkata

# --- Review schedule --------------------------------------------------------
MORNING_ALERT_TIME=09:00
EVENING_ALERT_TIME=17:00
# 0=Monday .. 6=Sunday
WORKING_DAYS=0,1,2,3,4
SKIP_ON_HOLIDAYS=true
DEFAULT_POSTPONE_MINUTES=5

# --- Missed-window rule -----------------------------------------------------
# How stale a frozen report may be and still send unattended.
SEND_GRACE_MINUTES=60
# A report must never send on a different calendar day than it was approved.
# This is checked BEFORE the grace window and overrides it.
ENFORCE_DAY_BOUNDARY=true
# Defer if task data changed since approval. Off by default: snapshots exist
# precisely so that drift is expected and harmless.
STRICT_DATA_DRIFT=false
# Deferred jobs auto-cancel after this long, audited.
DEFERRED_JOB_TTL_HOURS=48

# --- Scheduler --------------------------------------------------------------
SCHEDULER_TICK_SECONDS=30
CLAIM_BATCH_SIZE=50
CLAIM_LEASE_SECONDS=120

# --- Retry ladder -----------------------------------------------------------
# Seconds before each attempt. Length defines max attempts.
RETRY_DELAYS_SECONDS=0,30,120,600

# --- Task source ------------------------------------------------------------
# Phase 1: database. Phase 2 adds google_sheets / excel.
TASK_SOURCE=database

# --- WhatsApp ---------------------------------------------------------------
# Phase 1: mock. Phase 3 adds local_agent (Baileys) / cloud_api.
WHATSAPP_PROVIDER=mock
MAX_MESSAGE_LENGTH=4096

# --- Google Sheets sync ------------------------------------------------------
# mock: harmless in-memory fake, always the safe default. google: real sync --
# see docs/google-sheets-setup.md before switching this on.
SHEETS_PROVIDER=mock
# GOOGLE_SERVICE_ACCOUNT_PATH=C:\path\to\service-account.json
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_SHEET_NAME=Tasks
SHEET_SYNC_INTERVAL_SECONDS=60

# --- Feature flags ----------------------------------------------------------
ALLOW_CUSTOM_SEND_TIME=true
ALLOW_ADD_TASK=true
ALLOW_INLINE_EDIT=true

# --- Idempotency ------------------------------------------------------------
IDEMPOTENCY_KEY_TTL_HOURS=24

# --- Default actor ------------------------------------------------------------
# Phase 1 has no login flow. Every request acts as this configured user unless
# overridden per-request via X-Actor-Id / X-Actor-Name headers. Placeholder,
# not a security boundary -- fine for a single-user tool on its owner's own
# laptop, not once this becomes multi-user.
DEFAULT_USER_ID=u-default
DEFAULT_USER_NAME=Kaif
